# ============================================================
# 电商内容 Agent - 环境变量配置模板
# 使用方法: 复制此文件为 .env 并填入实际值
#   cp .env.example .env
# ============================================================

# ----------------------------------------------------------
# 模型后端配置
# 可选值: mock | vllm | transformers | api
#   mock:          无需 GPU/API，用于开发测试和流程验证
#   vllm:          本地 vLLM 推理服务 (OpenAI 兼容 API)
#   transformers:  直接加载 HuggingFace 模型 + LoRA adapter
#   api:           外部 API (OpenAI / DashScope / 其他兼容接口)
# ----------------------------------------------------------
MODEL_BACKEND=mock
MODEL_NAME=ecommerce-copywriter

# ----------------------------------------------------------
# API 后端配置 (MODEL_BACKEND=vllm 或 api 时生效)
# ----------------------------------------------------------
API_BASE=http://localhost:8000/v1
API_KEY=not-needed

# ----------------------------------------------------------
# Transformers 后端配置 (MODEL_BACKEND=transformers 时生效)
# ----------------------------------------------------------
MODEL_PATH=models/Qwen3-8B-Instruct
LORA_PATH=output/ecommerce_qlora_sft_8b

# ----------------------------------------------------------
# 生成参数
# ----------------------------------------------------------
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=1024

# ----------------------------------------------------------
# 服务配置
# ----------------------------------------------------------
# 未配置服务鉴权时只监听本机；经反向代理保护后再改为 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8888

# ----------------------------------------------------------
# Agent 编排配置
# ----------------------------------------------------------
MAX_REWRITE_ROUNDS=2

# ----------------------------------------------------------
# 视频生成配置 (Seedance)
# 可选值: 留空(禁用) | mock | api
#   mock:  无需 API Key，用于流程验证
#   api:   调用 Seedance API (火山引擎方舟)
# ----------------------------------------------------------
# VIDEO_BACKEND=mock
# SEEDANCE_API_KEY=replace-with-real-key
# 必须填写方舟控制台中已开通的模型 ID 或推理接入点 ID
# SEEDANCE_MODEL=replace-with-seedance-model-id
# SEEDANCE_CREATE_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
# SEEDANCE_QUERY_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
# VIDEO_DURATION=5
# VIDEO_RESOLUTION=720p
# VIDEO_RATIO=16:9
# VIDEO_POLL_INTERVAL=5
# VIDEO_MAX_WAIT=600

# ----------------------------------------------------------
# 图片生成配置 (Seedream)
# 可选值: 留空(禁用) | mock | api
#   mock:  无需 API Key，用于流程验证
#   api:   调用 Seedream API (火山引擎方舟)
# ----------------------------------------------------------
# IMAGE_BACKEND=mock
# SEEDREAM_API_KEY=replace-with-real-key
# 必须填写方舟控制台中已开通的模型 ID 或推理接入点 ID
# SEEDREAM_MODEL=replace-with-seedream-model-id
# SEEDREAM_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# IMAGE_SIZE=landscape_16_9

# ----------------------------------------------------------
# 本地任务与媒体存储
# ----------------------------------------------------------
MEDIA_OUTPUT_DIR=output
TASK_DB_PATH=output/tasks.db

# ----------------------------------------------------------
# 外部 API Keys (按需配置)
# 取消注释并填入实际的 Key
# ----------------------------------------------------------
# OPENAI_API_KEY=replace-with-real-key
# OPENAI_API_BASE=https://api.openai.com/v1
# DASHSCOPE_API_KEY=replace-with-real-key
# QWEN_API_KEY=replace-with-real-key

# ----------------------------------------------------------
# 训练配置 (可选)
# ----------------------------------------------------------
# TRAIN_BASE_MODEL=Qwen/Qwen3-8B-Instruct
# TRAIN_OUTPUT_DIR=output/ecommerce_qlora_sft_8b
# TRAIN_EPOCHS=3
# TRAIN_BATCH_SIZE=4
# TRAIN_GRAD_ACCUM=4
# TRAIN_LEARNING_RATE=2e-4
# TRAIN_LORA_RANK=64
# TRAIN_LORA_ALPHA=128

# ----------------------------------------------------------
# 评估配置 (可选)
# ----------------------------------------------------------
# EVAL_TEST_FILE=data/labeled/test.json
# EVAL_BASE_MODEL=models/Qwen3-8B-Instruct
# EVAL_OUTPUT_DIR=output/eval_results

# ----------------------------------------------------------
# RAG / 知识库配置 (规划中)
# ----------------------------------------------------------
# RAG_ENABLED=false
# RAG_BACKEND=chromadb
# RAG_PERSIST_DIR=data/vector_db
# RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ----------------------------------------------------------
# 观测与日志
# ----------------------------------------------------------
# LOG_LEVEL=INFO
# OTEL_ENABLED=false
# OTEL_ENDPOINT=http://localhost:4317
